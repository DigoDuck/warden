# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist-ssr/
*.local
.vite/
# Generated by `npm run gen:api` (frontend/scripts/gen-api.mjs) from the backend's live
# OpenAPI schema. Committing it would let it drift from warden/api/routes_*.py unnoticed;
# every dev/build/test/typecheck script regenerates it first, so it can never go stale.
frontend/src/api/schema.d.ts
# JSON report written by the rtk CLI wrapper when it runs `vitest` through the Claude Code
# hook, not a build artifact of the frontend itself.
.vitest/

# Ambiente e segredos
.env
.env.*
!.env.example
*.pem
*.key
secrets/
# Chave de assinatura JWT gerada por `make keys` (warden/identity/generate_keys.py).
# *.pem acima já cobre o arquivo em si; esta entrada nomeada é intencional (defesa em
# profundidade e clareza) caso algo mais acabe indo para essa pasta.
.keys/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

