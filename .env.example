# Copie para .env (que nunca vai para o git) e ajuste.

# Porta que o Postgres do Compose publica no host. Troque se 5434 tambem estiver ocupada:
#   docker ps --format "{{.Names}} {{.Ports}}"
WARDEN_DB_PORT=5434

DATABASE_URL=postgresql+asyncpg://warden:warden@localhost:5434/warden

# Necessaria so a partir do PR 3 (make demo). Vazia, o demo usa o FakeProvider.
ANTHROPIC_API_KEY=
