# Copy to .env (never committed) and adjust.

# Host port published by the Compose Postgres. Change it if 5434 is taken too:
#   docker ps --format "{{.Names}} {{.Ports}}"
WARDEN_DB_PORT=5434

# Host ports of the Compose api and frontend (`docker compose up`). Defaults shown.
WARDEN_API_PORT=8010
WARDEN_WEB_PORT=5180
# Host port of the Jaeger UI (ADR-033). The "Trace" link in the task screen opens it.
WARDEN_JAEGER_PORT=16686

DATABASE_URL=postgresql+asyncpg://warden:warden@localhost:5434/warden

# Only needed from PR 3 onwards (make demo). Left empty, the demo uses FakeProvider.
ANTHROPIC_API_KEY=

# Read by identity/broker.py (ADR-006). Left empty, get_credential refuses every GitHub scope.
# Never a real value here, this file is committed; the real token lives only in your local .env.
GITHUB_TOKEN=

# Read by tools/sandboxed.py::build_registry (ADR-025). github.open_pr is only registered
# when this AND GITHUB_TOKEN are both set. "owner/name", e.g. DigoDuck/warden-target-repo.
GITHUB_REPO=
# Override for GitHub Enterprise Server; the default is right for github.com.
GITHUB_API_URL=https://api.github.com

# Tracing (ADR-033). The Compose worker already sets these for its Jaeger. To trace a worker you
# start by hand (`make worker`), export them in the shell: the SDK reads the process environment,
# not this file. Without an endpoint nothing is exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=warden-worker
# What the task screen's "Trace" link points at (Vite env, read when the frontend is built).
# VITE_JAEGER_URL=http://localhost:16686
