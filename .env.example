# Copy to .env (never committed) and adjust.

# Host port published by the Compose Postgres. Change it if 5434 is taken too:
#   docker ps --format "{{.Names}} {{.Ports}}"
WARDEN_DB_PORT=5434

DATABASE_URL=postgresql+asyncpg://warden:warden@localhost:5434/warden

# Only needed from PR 3 onwards (make demo). Left empty, the demo uses FakeProvider.
ANTHROPIC_API_KEY=

# Read by identity/broker.py (ADR-006). Left empty, get_credential refuses every GitHub scope.
# Never a real value here, this file is committed; the real token lives only in your local .env.
GITHUB_TOKEN=

# Read by tools/sandboxed.py::build_registry (ADR-025). github.open_pr is only registered
# when this AND GITHUB_TOKEN are both set. "owner/name", e.g. DigoDuck/warden-target-repo.
GITHUB_REPO=
# Override for GitHub Enterprise Server; the default is right for github.com.
GITHUB_API_URL=https://api.github.com
